DISCORD_TOKEN=
GUILD_ID=
LOG_LEVEL=default
# discordgo's own gateway logging, separate from LOG_LEVEL: ERROR (default) |
# WARN | INFO | DEBUG. WARN adds the frame the gateway sent when startup fails
# with "Discord session unavailable". DEBUG also needs LOG_LEVEL=DEBUG, and
# logs every unrecognised gateway event with its full payload.
DISCORDGO_LOG_LEVEL=
BM_TOKEN=
GITHUB_APP_KEY=
GITHUB_APP_CLIENT_ID=
BEARER=
FORUM_DB_DSN=readonly_user:password@tcp(127.0.0.1:3306)/xenforo
LOA_NODE_IDS=180,400,540,178,369
SENTRY_DSN=
APP_ENV=development
