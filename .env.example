DISCORD_TOKEN=
GUILD_ID=
LOG_LEVEL=default
# discordgo's own gateway logging, separate from LOG_LEVEL: ERROR (default) |
# WARN | INFO | DEBUG. WARN adds the frame the gateway sent when startup fails
# with "Discord session unavailable". DEBUG also needs LOG_LEVEL=DEBUG, and
# logs every unrecognised gateway event with its full payload.
DISCORDGO_LOG_LEVEL=
BM_TOKEN=
BEARER=
FORUM_DB_DSN=readonly_user:password@tcp(127.0.0.1:3306)/xenforo
LOA_NODE_IDS=180,400,540,178,369
# Base name the /warden roles are composed from: "<base> Internal" and
# "<base> External". Must reproduce the Discord role name exactly. The code
# default is "Verified Warden"; the value below is what the roles are named in
# Discord now. Takes effect on restart.
WARDEN_ROLE_BASE_NAME=Verified Foxhole
SENTRY_DSN=
APP_ENV=development
# The bot's own Postgres store (hubs, spawned channels). Empty means no store:
# the bot logs `BOT_DB_DSN not set, bot store disabled` once and every command
# works as before. A set DSN that cannot be reached or migrated stops the bot
# at startup. Under docker compose the value is
# postgres://cavbot:<POSTGRES_PASSWORD>@postgres:5432/cavbot?sslmode=disable
# and the two passwords have to agree. The host `postgres` resolves only inside
# compose; for `go run .` against a local server use its own host and port.
BOT_DB_DSN=
# Read by the postgres image in docker-compose.yml, not by the bot. Sets the
# role's password on the first boot of an empty volume; inert after that. Must
# not be empty, or the image refuses to start and the bot waits on it forever.
POSTGRES_PASSWORD=change-me
# The panel, the bot's web UI signed in through the forum. Empty
# PANEL_ADDR means no listener: the bot logs `PANEL_ADDR not set, panel
# disabled` once and everything else works as before. Under docker compose the
# value is :8080, reached by Nginx Proxy Manager over the `edge` network and
# never published on the host. With PANEL_ADDR set, every other PANEL_*
# variable but PANEL_GROUP_IDS is required and a missing one stops the bot at
# startup. The panel also needs BOT_DB_DSN above, since the hub page reads the
# store on every load; without it the bot logs `BOT_DB_DSN not set, panel
# disabled` and runs with no panel.
PANEL_ADDR=
# The public origin the panel is reached at, no trailing slash. The OAuth
# redirect URI is this plus /auth/callback and has to match a redirect URI
# registered on the forum client character for character, port included. The
# client holds two: https://cavbot2.7cav.us/auth/callback for production and
# http://localhost/auth/callback for a local run. So a local run sets
# PANEL_ADDR=:80 and PANEL_BASE_URL=http://localhost. The forum refused
# http://localhost:8080/auth/callback on 2026-09-21.
PANEL_BASE_URL=https://cavbot2.7cav.us
# The confidential OAuth2 client registered in the forum's admin control panel
# (Setup > Service providers > OAuth2 clients) with both redirect URIs and the
# user:read and user:groups scopes ticked. The client form prints the three
# endpoint URLs; copy them from there rather than from here.
PANEL_OAUTH_CLIENT_ID=
PANEL_OAUTH_CLIENT_SECRET=
PANEL_OAUTH_AUTHORIZE_URL=https://7cav.us/oauth2/authorize
PANEL_OAUTH_TOKEN_URL=https://7cav.us/api/oauth2/token
PANEL_OAUTH_USERINFO_URL=https://7cav.us/api/me
# Forum group IDs that may open the panel, primary or secondary: Genstaff (71),
# S6 HQ (47) and Regimental Technical Aides (44). The code default is the same
# three; the value here is what production runs. A value that does not parse
# stops the bot at startup.
PANEL_GROUP_IDS=71,47,44
