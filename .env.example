DISCORD_TOKEN=
GUILD_ID=
LOG_LEVEL=default
# discordgo's own gateway logging, separate from LOG_LEVEL: ERROR (default) |
# WARN | INFO | DEBUG. WARN adds the frame the gateway sent when startup fails
# with "Discord session unavailable". DEBUG also needs LOG_LEVEL=DEBUG, and
# logs every unrecognised gateway event with its full payload.
DISCORDGO_LOG_LEVEL=
BM_TOKEN=
BEARER=
FORUM_DB_DSN=readonly_user:password@tcp(127.0.0.1:3306)/xenforo
LOA_NODE_IDS=180,400,540,178,369
# Base name the /warden roles are composed from: "<base> Internal" and
# "<base> External". Must reproduce the Discord role name exactly. The code
# default is "Verified Warden"; the value below is what the roles are named in
# Discord now. Takes effect on restart.
WARDEN_ROLE_BASE_NAME=Verified Foxhole
SENTRY_DSN=
APP_ENV=development
# The bot's own Postgres store (hubs, spawned channels). Empty means no store:
# the bot logs `BOT_DB_DSN not set, bot store disabled` once and every command
# works as before. A set DSN that cannot be reached or migrated stops the bot
# at startup. Under docker compose the value is
# postgres://cavbot:<POSTGRES_PASSWORD>@postgres:5432/cavbot?sslmode=disable
# and the two passwords have to agree. The host `postgres` resolves only inside
# compose; for `go run .` against a local server use its own host and port.
BOT_DB_DSN=
# Read by the postgres image in docker-compose.yml, not by the bot. Sets the
# role's password on the first boot of an empty volume; inert after that. Must
# not be empty, or the image refuses to start and the bot waits on it forever.
POSTGRES_PASSWORD=change-me
