DISCORD_TOKEN=
GUILD_ID=
LOG_LEVEL=default
# discordgo's own gateway logging: ERROR (default, and what the bot did before
# this knob existed) | WARN | INFO | DEBUG. Set WARN to log the frame the
# gateway sent instead of READY when startup fails. DEBUG is for local work and
# needs LOG_LEVEL=DEBUG as well; it logs every gateway event discordgo does not
# recognise, with the event's full payload.
DISCORDGO_LOG_LEVEL=
BM_TOKEN=
GITHUB_APP_KEY=
GITHUB_APP_CLIENT_ID=
BEARER=
FORUM_DB_DSN=readonly_user:password@tcp(127.0.0.1:3306)/xenforo
LOA_NODE_IDS=180,400,540,178,369
SENTRY_DSN=
APP_ENV=development
