DISCORD_TOKEN=
GUILD_ID=
LOG_LEVEL=default
# discordgo's own gateway logging, separate from LOG_LEVEL: ERROR (default) |
# WARN | INFO | DEBUG. WARN adds the frame the gateway sent when startup fails
# with "Discord session unavailable". DEBUG also needs LOG_LEVEL=DEBUG, and
# logs every unrecognised gateway event with its full payload.
DISCORDGO_LOG_LEVEL=
BM_TOKEN=
BEARER=
FORUM_DB_DSN=readonly_user:password@tcp(127.0.0.1:3306)/xenforo
LOA_NODE_IDS=180,400,540,178,369
# Base name the /warden roles are composed from: "<base> Internal" and
# "<base> External". Must reproduce the Discord role name exactly. The code
# default is "Verified Warden"; the value below is what the roles are named in
# Discord now. Takes effect on restart.
WARDEN_ROLE_BASE_NAME=Verified Foxhole
SENTRY_DSN=
APP_ENV=development
# The bot's own Postgres database, for hub settings and spawned channel rows.
# Unset, the bot runs with no store and no hubs. The host is the compose
# service name. POSTGRES_PASSWORD is read by compose for the postgres service
# only, never by the bot, so it is not in the compose environment block; the
# two passwords must agree.
POSTGRES_PASSWORD=password
BOT_DB_DSN=postgres://cavbot:password@postgres:5432/cavbot?sslmode=disable
# The panel, cavbot2's web UI signed in through the forum. Leave PANEL_ADDR
# empty and the panel does not listen. Set it (production uses :8080) and
# every PANEL_OAUTH_ variable is required; a missing one fails the start
# before the bot touches Discord. PANEL_BASE_URL plus /auth/callback must
# equal a redirect URI registered on the forum's OAuth client, character for
# character; for a local run register http://localhost/auth/callback (the
# forum ignores the port on localhost). PANEL_GROUP_IDS defaults to Genstaff,
# S6 HQ and Regimental Technical Aides.
PANEL_ADDR=
PANEL_BASE_URL=http://localhost:8080
PANEL_OAUTH_CLIENT_ID=
PANEL_OAUTH_CLIENT_SECRET=
PANEL_OAUTH_AUTHORIZE_URL=https://7cav.us/oauth2/authorize
PANEL_OAUTH_TOKEN_URL=https://7cav.us/api/oauth2/token
PANEL_OAUTH_USERINFO_URL=https://7cav.us/api/me
PANEL_GROUP_IDS=71,47,44
